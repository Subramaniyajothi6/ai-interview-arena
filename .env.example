# Copy this file to .env.local and fill in the values.
# Never commit .env.local. On Vercel, add the same variables under
# Project Settings -> Environment Variables.

# --- Supabase (Project Settings -> API Keys) -------------------------------
# Public: safe in the browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret: server only. Bypasses row level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- OpenAI (platform.openai.com -> API keys) ------------------------------
# Server only. Used by the API routes for resume analysis, questions,
# evaluation, reports and voice transcription.
OPENAI_API_KEY=sk-xxx
# Optional overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- App ---------------------------------------------------------------------
# Used for auth email links (password reset, email confirmation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
